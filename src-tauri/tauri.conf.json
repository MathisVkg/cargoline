{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cargo Line",
  "version": "0.1.0",
  "identifier": "io.github.mathisvkg.sccargoapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cargo Line",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "decorations": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "center": true,
        "backgroundColor": "#0a0c0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: capture: http://capture.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/tesseract/tesseract.exe": "tesseract/tesseract.exe",
      "resources/tesseract/tessdata/eng.traineddata": "tesseract/tessdata/eng.traineddata"
    }
  }
}
